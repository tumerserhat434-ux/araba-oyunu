rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.data.size() < 900000;
    }
    match /players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.power is number;
      match /inbox/{id} {
        allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    // İttifaklar: lider her şeyi yönetir; üyeler yalnızca kendi kaydını ekler/günceller/siler
    match /alliances/{aid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.leader == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.tag is string && request.resource.data.tag.size() <= 4
        && request.resource.data.members.keys().hasOnly([request.auth.uid]);
      allow update: if request.auth != null && (
        resource.data.leader == request.auth.uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && (request.auth.uid in resource.data.members || resource.data.open == true)
            && request.resource.data.members.size() <= 50));
      allow delete: if request.auth != null && resource.data.leader == request.auth.uid;
      match /rallies/{rid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow create: if request.auth != null
          && request.resource.data.leader == request.auth.uid
          && request.resource.data.members.keys().hasOnly([request.auth.uid])
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow update: if request.auth != null && (
          (resource.data.leader == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members.size() <= 5
            && resource.data.status == 'open'
            && request.time.toMillis() < resource.data.endsAt
            && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members));
      }
      // İttifak yardımı: isteyen kendi isteğini açar/siler; diğer üyeler yalnızca kendilerini yardımcı olarak ekler (en fazla 20)
      match /helps/{hid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.helpers.size() == 0
          && request.resource.data.per is number && request.resource.data.per <= 86400
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow update: if request.auth != null
          && resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpers'])
          && request.resource.data.helpers.diff(resource.data.helpers).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in resource.data.helpers)
          && request.resource.data.helpers.size() <= 20
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/alliances/$(aid)).data.leader == request.auth.uid);
      }
      match /chat/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.auth.uid in get(/databases/$(database)/documents/alliances/$(aid)).data.members;
      }
    }
  }
}
